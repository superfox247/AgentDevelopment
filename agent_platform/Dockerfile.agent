# Universal Agent Dockerfile
# Usage: docker build --build-arg AGENT_PATH=agents/researcher_agent .

# Builder stage
FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv

WORKDIR /app

# Argument to specify which agent we are building
ARG AGENT_PATH
# Verify ARG is passed
RUN test -n "$AGENT_PATH" || (echo "AGENT_PATH argument is required" && false)

# Install dependencies (only for the specific agent)
COPY ${AGENT_PATH}/pyproject.toml ${AGENT_PATH}/uv.lock ./
RUN uv sync --frozen --no-install-project

# Install Platform Dependencies (Shared Layer)
# We install these AFTER agent sync so they are added to the venv
COPY agent_platform /tmp/agent_platform
RUN uv pip install /tmp/agent_platform

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Copy the environment from the builder
COPY --from=builder /app/.venv /app/.venv

# Copy Shared Layers
COPY agent_platform /app/agent_platform
COPY .agent /app/.agent

# Copy the specific agent code to /app/agent
# Extract agent name from path (e.g., agents/researcher_agent -> researcher_agent)
ARG AGENT_PATH
COPY ${AGENT_PATH} /app/agent

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"
# Add /app to PYTHONPATH so we can import 'agent_platform' and agent modules
ENV PYTHONPATH="/app:$PYTHONPATH"

# Switch to non-root user
USER appuser

# Reset the entrypoint
ENTRYPOINT []

# Standard ADK Port
EXPOSE 8080

# Run the agent's server entry point
# Assumes agent has server.py that creates the FastAPI app
CMD ["uvicorn", "agent.server:app", "--host", "0.0.0.0", "--port", "8080"]
