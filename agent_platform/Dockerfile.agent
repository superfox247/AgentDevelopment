# Universal Agent Dockerfile
# Usage: docker build --build-arg AGENT_PATH=domains/content_creation/researcher .

# Builder stage
FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv

WORKDIR /app

# Argument to specify which agent we are building
ARG AGENT_PATH
# Verify ARG is passed
RUN test -n "$AGENT_PATH" || (echo "AGENT_PATH argument is required" && false)

# Install dependencies (only for the specific agent)
COPY ${AGENT_PATH}/pyproject.toml ${AGENT_PATH}/uv.lock ./
RUN uv sync --frozen --no-install-project

# Install Platform Dependencies (Shared Layer)
# We install these AFTER agent sync so they are added to the venv
COPY agent_platform /tmp/agent_platform
RUN uv pip install /tmp/agent_platform

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Copy the environment from the builder
COPY --from=builder /app/.venv /app/.venv

# Copy Shared Layers
COPY agent_platform /app/agent_platform
COPY schemas /app/schemas
COPY .agent /app/.agent

# Copy the specific agent code to /app/orchestrator
# We use a build arg to find the source, but destination is always standard /app/orchestrator
ARG AGENT_PATH
COPY ${AGENT_PATH} /app/orchestrator

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"
# Add /app to PYTHONPATH so we can import 'agent_platform', 'registry', and 'orchestrator'
ENV PYTHONPATH="/app:$PYTHONPATH"

# Reset the entrypoint
ENTRYPOINT []

# Standard ADK Port
EXPOSE 8080

# Run the standard platform server
CMD ["uvicorn", "orchestrator.server:app", "--host", "0.0.0.0", "--port", "8080"]
