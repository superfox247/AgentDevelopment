# Copy to .env and adjust.
# Never commit .env or store secrets in it.

# API key: Set GEMINI_API_KEY in Windows (User or System). make.ps1 uses it everywhere.
# Optional: uncomment below for local Docker only if you run docker compose directly (no make.ps1).
# GEMINI_API_KEY=your_key_here

GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Optional: Docker Compose / Phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
